generator client {
  provider = "prisma-client-js"
}

// Seed script configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") — use DIRECT_URL override for db push
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  username          String?
  password          String?        // Hashed password for custom auth
  totalGems         Int            @default(0)
  totalRiddlesSolved Int          @default(0)
  currentStreak     Int            @default(0)
  longestStreak     Int            @default(0)
  lastPlayedDate    DateTime?
  currentLevel      Int            @default(1)
  dailyChallengeStreak Int         @default(0) // Consecutive daily challenge completions
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  gameSessions      GameSession[]
  riddleAttempts    RiddleAttempt[]
  achievements      UserAchievement[]
  activityLogs      ActivityLog[]
  inventory         UserInventory[]
  dailyChallengeEntries DailyChallengeEntry[]
  mysteryBoxOpenings MysteryBoxOpening[]
  userRiddles UserRiddle[]
  userRiddleVotes UserRiddleVote[]
}

// ... existing models ...

model StoreItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // 'AVATAR' | 'BADGE' | 'CONSUMABLE'
  rarity      String   @default("COMMON") // 'COMMON' | 'RARE' | 'EPIC' | 'LEGENDARY'
  price       Int
  imageUrl    String   // URL or lucide-icon-name
  isActive    Boolean  @default(true)
  metadata    String?  // JSON for extra properties
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userInventories UserInventory[]
}

model UserInventory {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  isEquipped  Boolean   @default(false)
  acquiredAt  DateTime  @default(now())
  
  @@unique([userId, itemId])
  @@index([userId])
}


model Riddle {
  id          String           @id @default(cuid())
  question    String           @unique
  answer      String           // JSON array stored as string, parse in app
  difficulty  String           // 'easy' | 'medium' | 'hard'
  category    String?
  hint1       String?          // First letter
  hint2       String?          // Word length
  tags        String           @default("[]") // JSON array
  isActive    Boolean          @default(true)
  order       Int?             // Display order
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  attempts    RiddleAttempt[]
  activityLogs ActivityLog[]
  dailyChallenges DailyChallenge[]
  approvedUserRiddles UserRiddle[]

  @@index([difficulty])
}

model GameSession {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRiddleId String?
  solvedRiddles   String    @default("[]") // JSON array of riddle IDs
  skippedRiddles  String    @default("[]") // JSON array of riddle IDs
  userGems        Int       @default(50)
  currentLevel    Int       @default(1)
  hintsUsed       String?   // JSON string: { riddleId: [1, 2, 3] }
  startedAt       DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
}

model RiddleAttempt {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  riddleId      String
  riddle        Riddle    @relation(fields: [riddleId], references: [id], onDelete: Cascade)
  isCorrect     Boolean
  answerGiven   String?
  hintsUsed     String    @default("[]") // JSON array of hint numbers
  gemsEarned    Int       @default(0)
  gemsSpent     Int       @default(0)
  timeSpent     Int?      // Time in seconds
  modifier      String?   // 'NO_HINTS' | 'HALF_TIMER' | 'REVERSE'
  createdAt     DateTime  @default(now())
  
  @@index([userId])
  @@index([riddleId])
  @@index([createdAt])
}

model Achievement {
  id          String            @id @default(cuid())
  name        String
  description String
  icon        String
  condition   String            @unique // e.g., "solve_100_riddles", "streak_7_days"
  reward      Int?              // Gem reward
  createdAt   DateTime          @default(now())
  
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  
  @@unique([userId, achievementId])
  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  type        String   // e.g., 'riddle_created', 'user_solved', 'admin_action'
  category    String   // 'admin' | 'user' | 'system'
  title       String
  description String
  metadata    String?  // JSON string: Additional data
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  riddleId    String?
  riddle      Riddle?  @relation(fields: [riddleId], references: [id], onDelete: SetNull)
  adminId     String?  // Admin user ID if admin action
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

model GameConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON string
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // Admin ID
}

model Admin {
  id          String   @id @default(cuid())
  code        String   @unique // Access code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([code])
}

model DailyChallenge {
  id          String   @id @default(cuid())
  riddleId    String
  riddle      Riddle   @relation(fields: [riddleId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date // Date-only field (YYYY-MM-DD)
  bonusGems   Int      @default(0) // Bonus gems for completing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  entries     DailyChallengeEntry[]
  
  @@unique([date])
  @@index([date])
}

model DailyChallengeEntry {
  id                String         @id @default(cuid())
  dailyChallengeId  String
  dailyChallenge    DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  solveTimeMs       Int?           // Time taken in milliseconds (null if incorrect)
  isCorrect         Boolean        @default(false)
  completedAt       DateTime       @default(now())
  
  @@unique([dailyChallengeId, userId])
  @@index([dailyChallengeId])
  @@index([userId])
  @@index([completedAt])
}

model MysteryBox {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  rarity      String   @default("COMMON") // 'COMMON' | 'RARE' | 'EPIC' | 'LEGENDARY'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rewards     MysteryBoxReward[]
  openings    MysteryBoxOpening[]

  @@index([isActive])
  @@index([rarity])
}

model MysteryBoxReward {
  id            String     @id @default(cuid())
  mysteryBoxId  String
  mysteryBox    MysteryBox @relation(fields: [mysteryBoxId], references: [id], onDelete: Cascade)

  type          String     // 'GEMS' | 'STORE_ITEM'
  value         String     // JSON string: e.g. { "amount": 50 } or { "itemId": "..." }
  rarity        String     @default("COMMON")
  weight        Int        @default(1) // weighted random selection
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  openings      MysteryBoxOpening[]

  @@index([mysteryBoxId])
  @@index([isActive])
  @@index([rarity])
}

model MysteryBoxOpening {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  mysteryBoxId  String
  mysteryBox    MysteryBox      @relation(fields: [mysteryBoxId], references: [id], onDelete: Cascade)

  rewardId      String
  reward        MysteryBoxReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  rewardData    String          // JSON string of resolved reward (e.g. gems amount, item details)
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([mysteryBoxId, createdAt])
}

model UserRiddle {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  question    String
  answer      String   // JSON array stored as string
  difficulty  String   // 'easy' | 'medium' | 'hard'
  category    String?
  hint1       String?
  hint2       String?
  tags        String   @default("[]") // JSON array
  
  status      String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  rejectionReason String?
  
  playCount   Int      @default(0) // Times this riddle has been played
  totalVotes  Int      @default(0) // Sum of all votes (+1/-1)
  voteCount   Int      @default(0) // Number of users who voted
  
  approvedRiddleId String? @unique // If approved, link to main Riddle table
  approvedRiddle   Riddle? @relation(fields: [approvedRiddleId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviewedAt  DateTime? // When admin reviewed it
  reviewedBy  String?  // Admin ID who reviewed
  
  votes       UserRiddleVote[]
  
  @@index([authorId])
  @@index([status])
  @@index([totalVotes])
  @@index([createdAt])
}

model UserRiddleVote {
  id          String     @id @default(cuid())
  userRiddleId String
  userRiddle  UserRiddle @relation(fields: [userRiddleId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  value       Int        // +1 for upvote, -1 for downvote
  createdAt   DateTime   @default(now())
  
  @@unique([userRiddleId, userId])
  @@index([userRiddleId])
  @@index([userId])
}
