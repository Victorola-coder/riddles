# ============================================
# Riddle Quest - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ============================================
# Database
# ============================================
# PostgreSQL connection string for Prisma
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/riddle_quest?schema=public"

# ============================================
# Authentication & Security
# ============================================
# Secret key for JWT token signing and verification
# Generate a strong random string for production (e.g., openssl rand -base64 32)
JWT_SECRET="your-secret-key-change-in-production"

# Admin access code for admin panel authentication
# Change this to a secure code in production
ADMIN_ACCESS_CODE="1234"

# ============================================
# Application URLs
# ============================================
# Public URL of your application (used for email links, API calls, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL for metadata and SEO (optional, falls back to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_BASE_URL="https://riddle-quest.vercel.app"

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP server settings for sending emails (password reset, etc.)
# If not configured, emails will be logged to console in development

# SMTP server hostname
# Examples:
#   - Gmail: smtp.gmail.com
#   - SendGrid: smtp.sendgrid.net
#   - Resend: smtp.resend.com
#   - Custom: mail.yourdomain.com
SMTP_HOST=""

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted - not recommended)
SMTP_PORT="587"

# SMTP authentication username
# Usually your email address or SMTP username
SMTP_USER=""

# SMTP authentication password
# Your email password or SMTP API key
SMTP_PASS=""

# Email "From" address (display name and email)
# Format: "Display Name <email@domain.com>"
EMAIL_FROM="Riddle Quest <no-reply@riddle-quest.test>"

# ============================================
# Supabase (Optional - if using Supabase features)
# ============================================
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
